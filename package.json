{
  "name": "screen-description-script-maker",
  "version": "0.5.0-beta.5",
  "description": "영상 음성과 화자를 분석해 화면해설 작업용 HWPX 대본을 만드는 Windows 데스크톱 앱",
  "main": "out/main/index.js",
  "author": "BuilderGarlic",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:assets": "node scripts/sync-runtime-assets.mjs",
    "sanitize:template": "tsx scripts/sanitize-template.ts",
    "qa:hwpx": "tsx scripts/create-qa-hwpx.ts",
    "dist:win": "npm run sync:assets && npm run build && electron-builder --win nsis",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.11",
    "electron-updater": "6.8.9",
    "openai": "^7.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "write-file-atomic": "^8.0.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/write-file-atomic": "^4.0.3",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "kr.ginuni.screenDescriptionScriptMaker",
    "productName": "화면해설 대본 도구",
    "asar": true,
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "buildergarlic",
        "repo": "ginuni"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ScreenDescriptionScriptMaker-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "화면해설 대본 도구",
      "deleteAppDataOnUninstall": false
    }
  }
}
